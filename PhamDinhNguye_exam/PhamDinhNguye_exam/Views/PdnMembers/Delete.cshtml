@model PhamDinhNguye_exam.Models.PdnEmployee

@{
    ViewData["Title"] = "Xóa sinh viên";
}

<div class="container mt-4">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">@ViewData["Title"]</h4>
        </div>
        <div class="card-body">
            <!-- Cảnh báo xác nhận -->
            <div class="alert alert-warning border-warning d-flex align-items-center mb-4" role="alert">
                <div>
                    <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa thông tin sinh viên này không? Hành động này không thể hoàn tác.
                </div>
            </div>

            <h5 class="card-title text-secondary mb-3">Thông tin chi tiết</h5>
            
            <!-- Danh sách chi tiết thông tin sinh viên -->
            <dl class="row bg-light p-3 rounded">
                <dt class="col-sm-3 col-md-2 font-weight-bold">
                    @Html.DisplayNameFor(model => model.PdnName)
                </dt>
                <dd class="col-sm-9 col-md-10">
                    @Html.DisplayFor(model => model.PdnName)
                </dd>

                <dt class="col-sm-3 col-md-2 font-weight-bold">
                    @Html.DisplayNameFor(model => model.PdnGender)
                </dt>
                <dd class="col-sm-9 col-md-10">
                    @Html.DisplayFor(model => model.PdnGender)
                </dd>

                <dt class="col-sm-3 col-md-2 font-weight-bold">
                    @Html.DisplayNameFor(model => model.PdnBirthDay)
                </dt>
                <dd class="col-sm-9 col-md-10">
                    @Html.DisplayFor(model => model.PdnBirthDay)
                </dd>

                <dt class="col-sm-3 col-md-2 font-weight-bold">
                    @Html.DisplayNameFor(model => model.PdnEmail)
                </dt>
                <dd class="col-sm-9 col-md-10">
                    @Html.DisplayFor(model => model.PdnEmail)
                </dd>

                <dt class="col-sm-3 col-md-2 font-weight-bold">
                    @Html.DisplayNameFor(model => model.PdnPhone)
                </dt>
                <dd class="col-sm-9 col-md-10">
                    @Html.DisplayFor(model => model.PdnPhone)
                </dd>

                <dt class="col-sm-3 col-md-2 font-weight-bold">
                    @Html.DisplayNameFor(model => model.PdnActive)
                </dt>
                <dd class="col-sm-9 col-md-10">
                    @if (Model.PdnActive)
                    {
                        <span class="badge bg-success">Đang học</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Đã nghỉ</span>
                    }
                </dd>
            </dl>

            <!-- Form thao tác xóa -->
            <form asp-action="Delete" class="mt-4 pt-2 border-top">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger me-2">
                    Xác nhận xóa
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Quay lại danh sách
                </a>
            </form>
        </div>
    </div>
</div>