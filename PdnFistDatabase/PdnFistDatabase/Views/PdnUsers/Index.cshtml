@model IEnumerable<PdnFirstDatabase.Models.PdnUser>

@{
    ViewData["Title"] = "Danh Sách Sinh Viên";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PdnUsername)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdnPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdnFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdnEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdnPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PdnUsername)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PdnPassword)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PdnFullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PdnEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PdnPhone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PdnId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.PdnId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.PdnId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
