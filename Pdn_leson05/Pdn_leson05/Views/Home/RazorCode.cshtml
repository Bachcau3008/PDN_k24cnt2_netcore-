@{
	ViewData["Title"] = "Cú pháp Razor C#";
}
<h1>@ViewData["Title"]</h1>
<hr/>
@{
	var total = 7500;
	var myMessage = "Khá là..... giàu đấy";

}

<p>Tài khoản của bạn : $ @total</p>
<p>@myMessage</p>

<h2>Cấu trúc if</h2>
<hr/>
	
@if (total > 5000)
{
	<p>Bạn là người giàu có</p>
}
else if (total > 2500)
{
	<p>Bạn là người khá giả</p>
}
else
{
	<p>Chưa thể nghỉ ngơi đâu. Đi kiếm thêm đê! </p>
}

<h2>Cấu trúc lặp for (........)</h2>
@for (int i = 1; i <= 10; i++)
{
	if (i % 2 == 0)
	{
		<span class ="btn btn-danger ">@i</span>
	}
	else
	{
		<span class ="btn btn-success ">@i</span>

	}
}
<h2>Mảng</h2>
@{
	string[] myArray = { "icon1.png", "icon2.png", "icon3.png", "icon4.png", "icon5.png","1.png" };
}
@foreach (var item in myArray)
{
	<img src="~/images/@item" width="150" height="150" />
}